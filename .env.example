# Copy to .env and paste your key. .env is gitignored.
# Free public API key: https://www.virustotal.com/gui/my-apikey
#
# Free tier limits, which triagelab enforces client-side:
#   4 lookups / minute, 500 / day, 15.5k / month
#   Public API must not be used in business workflows or commercial products.
VT_API_KEY=

# Optional: seconds between live VT calls (default 16, keeps you under 4/min)
# VT_MIN_INTERVAL=16
